 *
 * Test-only SPI routing for the dual external SEMPER flash board:
 *   SCLK  -> PA5 (SPI1_SCK)
 *   MISO  -> PA6 (SPI1_MISO)
 *   MOSI  -> PA7 (SPI1_MOSI)
 *   nCS0  -> PE4
 *   nCS1  -> PE5
 *
 * PA7 conflicts with Ethernet RMII_CRS_DV, so Ethernet is disabled for
 * this test. The child nodes use the test-local driverless SPI binding: the test
 * performs raw, non-destructive identification transactions without a flash
 * driver.
 */

#include <zephyr/dt-bindings/gpio/gpio.h>

&mac {
	status = "disabled";
};

&mdio {
	status = "disabled";
};

&spi1 {
	pinctrl-0 = <&spi1_sck_pa5 &spi1_miso_pa6 &spi1_mosi_pa7>;
	pinctrl-names = "default";
	cs-gpios = <&gpioe 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>,
		   <&gpioe 5 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
	status = "okay";

	ext_flash0: flash-id@0 {
		compatible = "zephyr,spi-device";
		reg = <0>;
		spi-max-frequency = <1875000>;
		spi-cs-setup-delay-ns = <1000>;
		spi-cs-hold-delay-ns = <1000>;
	};

	ext_flash1: flash-id@1 {
		compatible = "zephyr,spi-device";
		reg = <1>;
		spi-max-frequency = <1875000>;
		spi-cs-setup-delay-ns = <1000>;
		spi-cs-hold-delay-ns = <1000>;
	};
};
